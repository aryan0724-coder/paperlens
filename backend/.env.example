# ----------------------------------------------------------------------------
# PaperLens backend secrets (set with: supabase secrets set KEY=value ...)
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are provided by
# the Supabase Edge runtime automatically and do NOT need to be set here.
# ----------------------------------------------------------------------------

# LLM provider (OpenAI-compatible). Required for summaries/chat to work.
# Example below uses Groq's free OpenAI-compatible endpoint.
LLM_API_KEY=gsk_your_groq_key
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL_FREE=openai/gpt-oss-120b
LLM_MODEL_PRO=openai/gpt-oss-120b

# Free tier: summaries allowed per calendar month before Pro is required.
FREE_MONTHLY_LIMIT=5

# ExtPay (optional) for server-side subscription verification.
EXTPAY_ID=paperlens
EXTPAY_API_KEY=
