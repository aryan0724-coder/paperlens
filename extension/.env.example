# ----------------------------------------------------------------------------
# PaperLens extension environment (Vite exposes only VITE_* vars to the client)
# Copy to `.env` and fill in. Do NOT commit `.env`.
# ----------------------------------------------------------------------------

# Supabase project (Auth + Edge Functions host)
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Base URL where the edge functions live.
# Defaults to `${VITE_SUPABASE_URL}/functions/v1` if left blank.
VITE_BACKEND_URL=

# Hosted checkout URL for the Pro subscription (your Gumroad product URL).
VITE_CHECKOUT_URL=https://YOURNAME.gumroad.com/l/paperlens
