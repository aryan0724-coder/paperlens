# ----------------------------------------------------------------------------
# PaperLens extension environment (Vite exposes only VITE_* vars to the client)
# Copy to `.env` and fill in. Do NOT commit `.env`.
# ----------------------------------------------------------------------------

# Supabase project (Auth + Edge Functions host)
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Base URL where the edge functions live.
# Defaults to `${VITE_SUPABASE_URL}/functions/v1` if left blank.
VITE_BACKEND_URL=

# ExtPay extension id/slug registered at https://extensionpay.com
# (Used client-side to show payment status and open the payment page.)
VITE_EXTPAY_ID=paperlens
